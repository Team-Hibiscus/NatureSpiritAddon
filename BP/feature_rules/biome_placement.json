      "y": "t.x = v.worldx/256; t.z = v.worldz/256; t.rivernoise = math.abs(q.noise(0.5*t.x + 3167.0, 0.5*t.z + 2396.0)*0.25 + q.noise(0.05*t.x - 1279.0, 0.05*t.z - 1279.0)); t.o = q.noise(v.worldz/13, v.worldx/13); t.px = t.x/2 + t.o*0.025 + t.rivernoise; t.pz = t.z/2 + t.o*0.025 + t.rivernoise; t.c1 = 0.0; t.n1 = 999.0; t.n2 = 999.0; t.i = 0; loop(9, {t.p1x = math.mod(t.i,3) - 1; t.p1z = math.floor(t.i/3) - 1; t.p2x = math.floor(t.px) + t.p1x; t.p2z = math.floor(t.pz) + t.p1z; t.p3x = math.mod(t.p2x*0.1031, 1); t.p3y = math.mod(t.p2z*0.1030, 1); t.p3z = math.mod(t.p2x*0.0973, 1); t.p3d = t.p3x*(t.p3y + 33.33) + t.p3y*(t.p3z + 33.33) + t.p3z*(t.p3x + 33.33); t.p3x = t.p3x + t.p3d; t.p3y = t.p3y + t.p3d; t.p3z = t.p3z + t.p3d; t.rx = math.mod((t.p3x + t.p3y)*t.p3z, 1); t.rz = math.mod((t.p3x + t.p3z)*t.p3y, 1); t.d4x = t.p2x + t.rx - t.px; t.d4z = t.p2z + t.rz - t.pz; t.d2 = t.d4x*t.d4x + t.d4z*t.d4z; (t.d2 < t.n1) ? { t.n2 = t.n1; t.n1 = t.d2; t.c1 = t.rx; } : { (t.d2 < t.n2) ? { t.n2 = t.d2; }; };});t.natures_spirit_biome = math.floor(t.c1*3); return q.heightmap(v.worldx, v.worldz) + 0;"
