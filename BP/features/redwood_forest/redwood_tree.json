{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "natures_spirit:redwood_forest/redwood_tree"
    },
    "base_block": ["minecraft:dirt", "minecraft:coarse_dirt"],
    // "base_cluster": {
    //   "num_clusters": 4,
    //   "cluster_radius": 3,
    //   "may_replace": ["minecraft:air"]
    // },
    "may_replace": ["minecraft:air"],
    "trunk": {
      "trunk_block": "natures_spirit:redwood_log",
      "trunk_height": {
        "range_min": 6,
        "range_max": 10
      },
      "height_modifier": {
        "range_min": -2,
        "range_max": 1
      }
    },
    "spruce_canopy": {
      "lower_offset": {
        "range_min": 1,
        "range_max": 3
      },
      "upper_offset": {
        "range_min": 0,
        "range_max": 3
      },
      "max_radius": {
        "range_min": 2,
        "range_max": 4
      },
      "leaf_block": "natures_spirit:redwood_leaves"
    }
  }
}

